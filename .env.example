# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=ramic_studio

# Session
JWT_SECRET=replace-with-a-long-random-secret

# Toss Payments test keys (never commit real values)
TOSS_CLIENT_KEY=test_ck_your_client_key
TOSS_SECRET_KEY=test_sk_your_secret_key

# AES-256-GCM input; use a long random value and keep it outside Git
PAYMENT_DATA_ENCRYPTION_KEY=replace-with-a-long-random-encryption-secret

# Steam key delivery via Resend
RESEND_API_KEY=re_your_api_key
NEWSLETTER_FROM=Ramic Studio <no-reply@example.com>
PUBLIC_BASE_URL=https://your-domain.example
